# ---------- فرمت پیام ----------
def format_signal_msg(side, entry, stop, target, qty, risk_amt, total, scores, vol):
    direction = "🟢 خرید (LONG)" if side == 1 else "🔴 فروش (SHORT)"
    top = sorted(scores.items(), key=lambda x: -abs(x[1]))[:5]
    score_lines = "\n".join(f"   {k}: {v:+.2f}" for k, v in top)
    sl_dist = abs(entry - stop)
    tp_dist = abs(target - entry)
    rr = tp_dist / sl_dist if sl_dist > 0 else 0
    return (
        f"🚀 سیگنال فیوچرز BTC ({SYMBOL})\n"
        f"━━━━━━━━━━━━━━━━\n"
        f"جهت: {direction}\n"
        f"امتیاز کل: {total:+.2f}\n"
        f"━━━━━━━━━━━━━━━━\n"
        f"قیمت ورود: {entry:,.2f}\n"
        f"حد ضرر: {stop:,.2f} (فاصله {sl_dist:,.2f})\n"
        f"حد سود: {target:,.2f} (فاصله {tp_dist:,.2f})\n"
        f"نسبت ریسک به بازده: 1:{rr:.2f}\n"
        f"━━━━━━━━━━━━━━━━\n"
        f"حجم: {qty:.6f} BTC (محدود به اهرم {LEVERAGE:.0f}x)\n"
        f"ریسک: {risk_amt:,.2f} USDT\n"
        f"ATR: {vol:,.2f}\n"
        f"━━━━━━━━━━━━━━━━\n"
        f"۵ استراتژی برتر:\n{score_lines}"
    )

def format_close_msg(side, entry, exit_px, pnl, balance, reason, total_pnl, wins, losses):
    direction = "🟢 LONG" if side == 1 else "🔴 SHORT"
    wr = wins / (wins + losses) * 100 if (wins + losses) > 0 else 0
    emoji = "✅" if pnl >= 0 else "❌"
    return (
        f"{emoji} بستن پوزیشن ({reason})\n"
        f"━━━━━━━━━━━━━━━━\n"
        f"جهت: {direction}\n"
        f"ورود: {entry:,.2f} → خروج: {exit_px:,.2f}\n"
        f"سود/زیان: {pnl:+,.2f} USDT\n"
        f"━━━━━━━━━━━━━━━━\n"
        f"موجودی: {balance:,.2f} USDT\n"
        f"سود/زیان تجمعی: {total_pnl:+,.2f} USDT\n"
        f"نرخ برد: {wr:.1f}% ({wins} برد / {losses} باخت)"
    )

# ---------- چرخه ----------
def cycle():
    init(); s = load()
    today = datetime.now(timezone.utc).date().isoformat()
    if s['day'] != today:
        s.update(day=today, day_start=s['balance'])
    if s['balance'] <= s['day_start'] * (1 - DAILY):
        save(s)
        return f'⛔ محدودیت ضرر روزانه | موجودی: {s["balance"]:,.2f}'

    try:
        m1 = get_bars('1m', 200)
        m5 = get_bars('5m', 300)
        m15 = get_bars('15m', 300)
        if len(m1) < 30 or len(m5) < 60 or len(m15) < 60:
            return '📡 داده کافی نیست'

        last = get_price()

        raw = s['position']
        if raw:
            p = Pos(**raw)
            
            # 1. بررسی حد ضرر و حد سود اصلی
            hit_stop = (last <= p.stop) if p.side == 1 else (last >= p.stop)
            hit_target = (last >= p.target) if p.side == 1 else (last <= p.target)
            
            # 2. بررسی شکست ساختار (خروج زودهنگام)
            struct_break, break_reason = check_structure_break(p, m1)

            unrealized = (last - p.entry) * p.qty * p.side
            p.peak_pnl = max(p.peak_pnl, unrealized)

            # حد ضرر متحرک
            sl_dist = abs(p.entry - p.stop)
            if p.peak_pnl > sl_dist * 1.5:
                if (p.side == 1 and p.entry > p.stop) or (p.side == -1 and p.entry < p.stop):
                    p.stop = p.entry
                    s['position'] = p.__dict__
                    print(f'🔒 حد ضرر متحرک فعال | SL به {p.entry:,.2f}')

            # تصمیم به خروج
            exit_reason = None
            if hit_stop: exit_reason = 'حد ضرر'
            elif hit_target: exit_reason = 'حد سود'
            elif struct_break: exit_reason = f'خروج ساختاری: {break_reason}'

            if exit_reason:
                pnl = unrealized
                s['balance'] += pnl
                s['total_pnl'] = s.get('total_pnl', 0) + pnl
                if pnl > 0: s['wins'] = s.get('wins', 0) + 1
                else: s['losses'] = s.get('losses', 0) + 1
                
                close_trade(p, last, pnl, exit_reason)
                s['position'] = None
                save(s)
                msg = format_close_msg(p.side, p.entry, last, pnl, s['balance'],
                                       exit_reason, s.get('total_pnl', 0),
                                       s.get('wins', 0), s.get('losses', 0))
                alert(msg)
                return msg

            save(s)
            d = 'LONG' if p.side == 1 else 'SHORT'
            return (f'📊 نگهداری | {d} | ورود: {p.entry:,.2f} | فعلی: {last:,.2f} | '
                    f'سود شناور: {unrealized:+,.2f} | SL: {p.stop:,.2f} | TP: {p.target:,.2f}')

        sig = generate_signal(m1, m5, m15)
        if not sig:
            save(s)
            return f'⏳ {datetime.now(timezone.utc).strftime("%H:%M:%S")} | بدون سیگنال | موجودی: {s["balance"]:,.2f}'

        side, entry, scores, total, vol = sig
        risk_amount = s['balance'] * RISK
        stop_dist = 1.5 * vol
        qty = risk_amount / stop_dist
        
        # --- اعمال محدودیت اهرم ---
        notional = qty * entry
        max_notional = s['balance'] * LEVERAGE
        if notional > max_notional:
            qty = max_notional / entry
            risk_amount = qty * stop_dist  # به‌روزرسانی ریسک واقعی
            print(f"⚠️ حجم به خاطر محدودیت اهرم {LEVERAGE:.0f}x کاهش یافت به {qty:.6f}")

        if side == 1:
            stop, target = entry - stop_dist, entry + 2.5 * vol
        else:
            stop, target = entry + stop_dist, entry - 2.5 * vol

        p = Pos(SYMBOL, side, entry, stop, target, qty,
                datetime.now(timezone.utc).isoformat(), 'MULTI12')
        s['position'] = p.__dict__
        save(s)

        msg = format_signal_msg(side, entry, stop, target, qty, risk_amount, total, scores, vol)
        alert(msg)

        d = "🟢 LONG" if side == 1 else "🔴 SHORT"
        top = sorted(scores.items(), key=lambda x: -abs(x[1]))[:3]
        score_str = ' | '.join(f'{k}:{v:+.1f}' for k, v in top)
        return (f'✅ سیگنال {d} | ورود: {entry:,.2f} | SL: {stop:,.2f} | TP: {target:,.2f} | '
                f'امتیاز: {total:+.2f} | حجم: {qty:.6f} | {score_str}')

    except Exception as e:
        return f'❌ خطا: {type(e).__name__}: {e}'

def close_trade(p, px, pnl, reason):
    c = sqlite3.connect(DB)
    c.execute('INSERT INTO trades(side,entry,exit,qty,pnl,opened,closed,reason) VALUES(?,?,?,?,?,?,?,?)',
              (p.side, p.entry, px, p.qty, pnl, p.opened,
               datetime.now(timezone.utc).isoformat(), reason))
    c.commit(); c.close()

